<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="RouteDevelopment.PageTutorial2"
    BackgroundColor="#FFF8FA">

    <Grid
        RowDefinitions="Auto,*,Auto,Auto"
        Padding="20,20,20,10">

        <Button
            Grid.Row="0"
            Text="→"
            FontSize="30"
            TextColor="#0E1627"
            BackgroundColor="Transparent"
            BorderColor="#0E1627"
            BorderWidth="2"
            CornerRadius="25"
            WidthRequest="50"
            HeightRequest="50"
            HorizontalOptions="End"
            VerticalOptions="Start" />

        <VerticalStackLayout
            Grid.Row="1"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Spacing="25"
            MaximumWidthRequest="330">

            <Label
                Text="Siga em Frente"
                FontSize="26"
                FontAttributes="Bold"
                TextColor="#0E1627"
                HorizontalTextAlignment="Center" />

            <Label
                Text="Agora é só seguir a rota e encontrar seu destino"
                FontSize="17"
                TextColor="#0E1627"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>

        <HorizontalStackLayout
            Grid.Row="2"
            HorizontalOptions="Center"
            Spacing="10"
            Margin="0,0,0,80">

            <Ellipse
              WidthRequest="20"
              HeightRequest="20"
              Fill="#C4C4C4" />

            <Ellipse
              WidthRequest="20"
              HeightRequest="20"
              Fill="#0E1627" />

        </HorizontalStackLayout>

        <Button
            Grid.Row="3"
            Text="Próximo"
            FontSize="25"
            FontAttributes="Bold"
            TextColor="#0E1627"
            BackgroundColor="Transparent"
            HorizontalOptions="Center"
            Clicked="NextButton_Clicked" />

    </Grid>

</ContentPage>